@@ -45,6 +51,7 @@ static void esp32_gpio_write(void *opaque, hwaddr addr,
                        uint64_t value, unsigned int size)
 {
     Esp32GpioState *s = ESP32_GPIO(opaque);
+    uint32_t before = s->gpio_out & s->gpio_enable;
 
     if (s->out_off && addr == s->out_off) {
         s->gpio_out = (uint32_t)value;
@@ -59,6 +66,15 @@ static void esp32_gpio_write(void *opaque, hwaddr addr,
     } else if (s->enable_w1tc_off && addr == s->enable_w1tc_off) {
         s->gpio_enable &= ~(uint32_t)value;
     }
+
+    /* ESP32 Playground: report output level changes to the bridge */
+    uint32_t after = s->gpio_out & s->gpio_enable;
+    uint32_t changed = before ^ after;
+    for (int pin = 0; pin < (int)s->num_gpios; pin++) {
+        if (changed & (1u << pin)) {
+            espplay_gpio_out_update(pin, (after >> pin) & 1);
+        }
+    }
 }
 
