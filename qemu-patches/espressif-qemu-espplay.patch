+/* ESP32 Playground: UART instance registry for bridge forwarding */
+static ESP32UARTState *espplay_uarts[4];
+static int espplay_uart_count;
+
+static int espplay_uart_index(ESP32UARTState *s)
+{
+    for (int i = 0; i < 4; i++) {
+        if (espplay_uarts[i] == s) {
+            return i;
+        }
+    }
+    return -1;
+}
+
+void esp32_uart_rx_feed(int uart, const uint8_t *data, int len);
 #include "trace.h"
 
 
@@ -247,7 +264,11 @@ static gboolean uart_transmit(void *do_not_use, GIOCondition cond, void *opaque)
 
     /* drain the fifo instantly, if the char device backend is not connected */
     if (!qemu_chr_fe_backend_open(&s->chr)) {
-        fifo8_reset(&s->tx_fifo);
+        while (fifo8_num_used(&s->tx_fifo) > 0) {
+            uint8_t b = fifo8_pop(&s->tx_fifo);
+            espplay_uart_data(espplay_uart_index(s), &b, 1);
+        }
+        esp32_uart_update_irq(s);
         return FALSE;
     }
 
@@ -256,6 +277,7 @@ static gboolean uart_transmit(void *do_not_use, GIOCondition cond, void *opaque)
         int r = qemu_chr_fe_write(&s->chr, &b, 1);
         if (r == 1) {
             fifo8_pop(&s->tx_fifo);
+            espplay_uart_data(espplay_uart_index(s), &b, 1);
         } else {
             s->tx_watch_handle = qemu_chr_fe_add_watch(&s->chr, G_IO_OUT | G_IO_HUP,
                                                        uart_transmit, s);
@@ -321,6 +343,15 @@ static void uart_receive(void *opaque, const uint8_t *buf, int size)
     esp32_uart_update_irq(s);
 }
 
+void esp32_uart_receive_bytes(void *opaque, const uint8_t *buf, int size);
+
+void esp32_uart_rx_feed(int uart, const uint8_t *data, int len)
+{
+    if (uart >= 0 && uart < 4 && espplay_uarts[uart] && len > 0) {
+        uart_receive(espplay_uarts[uart], data, len);
+    }
+}
+
 static int uart_can_receive(void *opaque)
 {
     ESP32UARTState *s = ESP32_UART(opaque);
@@ -385,6 +416,10 @@ static void esp32_uart_realize(DeviceState *dev, Error **errp)
